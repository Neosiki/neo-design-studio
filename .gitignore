# macOS
.DS_Store
**/.DS_Store

# 동영상 렌더 임시 산출물
.video-tmp-*/
**/.video-tmp-*/

# 개인 자산 인덱스(실제 개인정보는 저장하지 않고 예시 템플릿만 유지)
assets/personal-asset-index.json

# 环境变量（API key 等敏感信息，只保留 .env.example 模板）
.env
.env.local

# 음성 작업 디렉터리(TTS와 타임라인 임시 산출물)
**/_narration/
**/_narration_*/

# Node / editor / OS
node_modules/
*.swp
.idea/
.vscode/
Thumbs.db

# Verification artifacts（截图、临时测试脚本）
demos/_frames_*.png
demos/_verify.js
demos/_verify.mjs

# 开发/测试中间产物（skill 内部研发用，不分发给用户）
_style-research/
**/design-demos/

# Demo 大视频（用 GitHub Releases 分发，不进仓库膨胀）
demos/**/*.mp4
__pycache__/

# design CLI 생성물 — 예제·픽스처를 실행하면 생기며, 매번 재생성 가능하다
examples/**/out/
tests/fixtures/**/out/
examples/**/qa.json
examples/**/qa-report.html
tests/fixtures/**/qa.json
tests/fixtures/**/qa-report.html
examples/**/mix-plan.json
examples/**/mix.sh

# 체크포인트·수정 요청 (프로젝트 로컬 상태)
**/.design/

# API 서버 로그
*.pid



# 파일 역할: 저장소에 올리지 않을 임시·민감 파일 규칙

